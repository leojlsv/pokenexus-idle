{
  "name": "@pokenexus/game-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@pokenexus/game-types": "workspace:*"
  },
  "scripts": {
    "prebuild": "corepack pnpm --filter @pokenexus/game-types build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "corepack pnpm --filter @pokenexus/game-types build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "ingest": "corepack pnpm run build && node dist/maintenance-cli.js"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
