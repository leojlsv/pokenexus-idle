{
  "name": "@pokenexus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "pretypecheck": "corepack pnpm --filter @pokenexus/database build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "corepack pnpm --filter @pokenexus/database build",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pokenexus/database": "workspace:*",
    "@simplewebauthn/server": "14.0.2",
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260921.1",
    "typescript": "^5.7.3",
    "vitest": "4.1.11",
    "wrangler": "4.136.1"
  }
}
