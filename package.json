{
  "name": "pokenexus-idle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "eslint .",
    "roadmap:generate": "node scripts/project-roadmap.mjs generate",
    "roadmap:check": "node scripts/project-roadmap.mjs check",
    "portfolio:generate-local": "node scripts/project-portfolio-local.mjs generate",
    "portfolio:check-local": "node scripts/project-portfolio-local.mjs",
    "local:prealpha": "powershell -NoProfile -File scripts/local-prealpha.ps1",
    "local:prealpha:doctor": "powershell -NoProfile -File scripts/local-prealpha.ps1 -Action Doctor",
    "local:prealpha:reset": "powershell -NoProfile -File scripts/local-prealpha.ps1 -Action Reset",
    "local:prealpha:start": "powershell -NoProfile -File scripts/local-prealpha.ps1 -Action Start -Players 2",
    "local:prealpha:start-one": "powershell -NoProfile -File scripts/local-prealpha.ps1 -Action Start -Players 1",
    "local:prealpha:status": "powershell -NoProfile -File scripts/local-prealpha.ps1 -Action Status",
    "local:prealpha:smoke": "powershell -NoProfile -File scripts/local-prealpha.ps1 -Action Smoke",
    "local:prealpha:stop": "powershell -NoProfile -File scripts/local-prealpha.ps1 -Action Stop",
    "task-041:harness:local": "powershell -NoProfile -File scripts/task-041-first-prealpha-harness.ps1",
    "task-034:review": "corepack pnpm --filter @pokenexus/game-types build && corepack pnpm --filter @pokenexus/game-data exec vitest run --config integration/vitest.task034.config.ts",
    "task-034:publish": "corepack pnpm --filter @pokenexus/game-types build && corepack pnpm --filter @pokenexus/game-data exec vitest run --config integration/vitest.task034.publish.config.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.11.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  }
}
